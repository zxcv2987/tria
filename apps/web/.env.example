# apps/web이 읽는 환경변수 전체 목록. 실제 값은 이 파일에 넣지 말 것 (.env는 gitignore됨).
#
# [공통] 표시는 GitHub 저장소 Secret 또는 배포 환경(Vercel 등)에도
# 정확히 같은 값으로 등록해야 하는 항목.

# --- MVP 단일 분석 화면 (/api/analyze) ---
# 로컬 전용. codex CLI가 로그인돼 있어야 하고, 서버리스 배포에서는 동작하지 않는다.
TARGET_REPOSITORY_PATH=

# --- Asana ---
ASANA_PAT=                      # [공통] Task 조회용 Personal Access Token
ASANA_WEBHOOK_SECRET=           # [공통] Asana 웹훅 핸드셰이크(X-Hook-Secret)로 받는 값 — 웹훅을 실제 등록해야 발급됨

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=       # [공통] 예: https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=            # [공통] secret 키 (publishable 키 아님 — RLS를 우회해야 함)

# --- Runner Callback 인증 ---
CALLBACK_SECRET=                # [공통] GitHub Secret의 CALLBACK_SECRET과 반드시 동일한 값

# --- GitHub repository_dispatch (Tria 저장소 자신을 트리거) ---
GITHUB_DISPATCH_TOKEN=          # [공통] repo scope PAT 또는 GitHub App 설치 토큰
TRIA_GITHUB_OWNER=              # [공통] 예: zxcv2987
TRIA_GITHUB_REPO=                # [공통] 예: tria

# --- 콜백 수신 주소 ---
# 로컬에서는 GitHub Actions가 localhost로 못 쏘니 ngrok 등 터널 URL 필요.
# 배포 환경에서는 실제 공개 도메인(예: https://tria.vercel.app)을 넣는다.
TRIA_PUBLIC_BASE_URL=

# --- GitHub App (대상 저장소 checkout용, /settings/projects의 저장소 목록 조회에도 사용) ---
# GitHub Actions Secret과 동일한 값. [공통]
TRIA_READER_CLIENT_ID=
TRIA_READER_PRIVATE_KEY=
